{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALLTube",
  "version": "1.0.0",
  "identifier": "org.alltube.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ALLTube",
        "width": 1000,
        "height": 680,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ALLTube",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Telecharge videos et musiques, gratuit et sans limite",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
